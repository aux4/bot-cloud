{
  "scope": "aux4",
  "name": "bot-cloud",
  "version": "0.1.0",
  "description": "Run an aux4 WhatsApp bot on one aux4.cloud command machine",
  "license": "Apache-2.0",
  "tags": ["bot", "whatsapp", "cloud", "turso"],
  "dependencies": [
    "aux4/bot@>=0.2.9",
    "aux4/bot-meta@>=0.1.25",
    "aux4/secret-aux4-cloud"
  ],
  "type": "cloud",
  "cloud": {
    "deployment": "new-vm",
    "machine": {
      "name": "whatsapp-bot",
      "size": "xs",
      "disk": 1,
      "type": "command",
      "tenantCapabilities": {
        "packages": false,
        "webhooks": true
      }
    },
    "capabilities": ["turso:database"],
    "commands": ["whatsapp"]
  },
  "system": [
    ["test:node --version", "brew:node", "linux:nodejs"]
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "whatsapp",
          "execute": [
            "stdin:node ${packageDir}/lib/run.mjs values(botId, phoneNumberId, verifyToken, token, appSecret, apiUrl, db, tmpDir, queue, dedupeTtl)"
          ],
          "help": {
            "text": "Verify, enqueue, and process one signed WhatsApp webhook delivery",
            "variables": [
              {"name": "botId", "text": "Configured bot identifier", "default": "whatsapp-bot"},
              {"name": "phoneNumberId", "text": "Meta WhatsApp phone number ID", "default": "1450110568185980"},
              {"name": "verifyToken", "text": "Meta webhook verification token", "default": ""},
              {"name": "token", "text": "Meta system-user access token", "default": "secret://aux4-cloud/whatsapp/token", "hide": true},
              {"name": "appSecret", "text": "Meta app secret", "default": "secret://aux4-cloud/whatsapp/appSecret", "hide": true},
              {"name": "apiUrl", "text": "Meta Graph API base URL (override for tests)", "default": "https://graph.facebook.com"},
              {"name": "db", "text": "Bot state database", "default": "cloud"},
              {"name": "tmpDir", "text": "Temporary attachment directory", "default": "/tmp/aux4-bot"},
              {"name": "dedupeTtl", "text": "Webhook dedupe lifetime in seconds", "default": "129600"},
              {"name": "queue", "text": "Repository-backed queue configuration", "default": "{\"name\":\"whatsapp_bot_inbox\",\"provider\":\"repository\",\"db\":\"cloud\",\"visibility\":\"30\",\"maxAttempts\":\"5\"}"}
            ]
          }
        }
      ]
    }
  ]
}
